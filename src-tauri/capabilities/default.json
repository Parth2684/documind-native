{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-remove",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Music/Documind/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$MUSIC/Documind/**/*" }, { "path": "$APPCONFIG/**/*" }]
    }
  ]
}
