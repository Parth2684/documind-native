  "db_name": "SQLite",
  "query": "\n        SELECT\n            o.id,\n            o.text,\n            o.created_at,\n\n            t.id as tts_id,\n            t.created_at as tts_created_at,\n            t.time,\n            t.ocr_id,\n            t.path,\n            t.voice,\n            t.speed\n\n        FROM ocr_text o\n        LEFT JOIN tts t ON t.ocr_id = o.id\n        ORDER BY MAX(o.created_at, COALESCE(t.created_at, o.created_at)) DESC\n    ",
